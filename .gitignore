node_modules/
.narration-build/
.DS_Store
~$*
.deepeval/

# Source documents the site does not need. The 80th-session PDF is 93MB and is
# already public on un.org; the two .docx are internal working drafts. The data
# transcribed from them lives in data/ and is committed.
assets/*.pdf
assets/*.docx

# The synthesised bed before mixing — 53MB, regenerate with tools/score.mjs
.narration-build/

# Exported video. GitHub rejects files over 100MB and this is ~136MB;
# regenerate with `npm run video`.
*.mp4

# Headshots as they arrived — phone snaps, 2MB PNGs, scans of passport photos.
# The cropped 512px JPEGs beside them are what the site loads; these are kept
# on disk only so a crop can be redone, and are 21MB the room never needs.
assets/photos/_originals/
assets/photos/untitled folder/
